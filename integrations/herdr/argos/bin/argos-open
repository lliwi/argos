#!/usr/bin/env python3
"""Abre un panel del plugin Argos en Herdr: argos-open <entrypoint> <tab|split|popup>.

Modo tab (el de `argos.open-chat`): pestaña «argos» con el chat MAXIMIZADO.
  - Si la pestaña existe: la enfoca; si el chat sigue vivo en ella lo maximiza, y si no, abre
    uno nuevo dentro de esa pestaña y lo maximiza.
  - Si no existe: crea la pestaña con el chat, la nombra «argos» y lo maximiza.
El chat se reconoce por el título de su terminal («argos · chat», lo pone `argos chat`).
"""

from __future__ import annotations

import json
import os
import subprocess
import sys

HERDR = os.environ.get("HERDR_BIN_PATH") or "herdr"
TAB_NAME = os.environ.get("ARGOS_TAB_NAME") or "argos"
CHAT_TITLE = "argos · chat"


def herdr(*args: str) -> dict:
    res = subprocess.run([HERDR, *args], capture_output=True, text=True, check=False)
    try:
        data = json.loads(res.stdout or "{}")
    except ValueError:
        data = {}
    if res.returncode != 0 or "error" in data:
        err = (data.get("error") or {}).get("message") or res.stderr.strip() or res.stdout
        raise RuntimeError(f"herdr {' '.join(args[:3])}: {err}")
    return data.get("result") or {}


def workspace_args() -> list[str]:
    ws = os.environ.get("HERDR_WORKSPACE_ID")
    return ["--workspace", ws] if ws else []


def label_matches(label: str) -> bool:
    # Herdr puede anteponer el número: «argos», «[5] argos».
    label = (label or "").strip()
    return label == TAB_NAME or label.endswith(f" {TAB_NAME}") or label.endswith(f"]{TAB_NAME}")


def find_tab() -> dict | None:
    for tab in herdr("tab", "list", *workspace_args()).get("tabs") or []:
        if label_matches(tab.get("label", "")):
            return tab
    return None


def panes_of(tab_id: str) -> list[dict]:
    return [p for p in herdr("pane", "list").get("panes") or []
            if p.get("tab_id") == tab_id]


def is_chat(pane: dict) -> bool:
    title = pane.get("terminal_title_stripped") or pane.get("terminal_title") or ""
    return CHAT_TITLE in title


def new_pane_id(result: dict) -> str:
    pane = (result.get("plugin_pane") or {}).get("pane") or result.get("pane") or {}
    return pane.get("pane_id") or ""


def open_tab(entry: str) -> None:
    tab = find_tab()
    if tab:
        herdr("tab", "focus", tab["tab_id"])
        panes = panes_of(tab["tab_id"])
        chat = next((p for p in panes if is_chat(p)), None)
        if chat:
            herdr("pane", "zoom", chat["pane_id"], "--on")
            return
        args = ["plugin", "pane", "open", "--plugin", "argos", "--entrypoint", entry,
                "--placement", "split", "--direction", "right", "--focus"]
        if panes:
            args += ["--target-pane", panes[0]["pane_id"]]
        pane_id = new_pane_id(herdr(*args))
    else:
        result = herdr("plugin", "pane", "open", "--plugin", "argos", "--entrypoint", entry,
                       "--placement", "tab", "--focus", *workspace_args())
        pane = (result.get("plugin_pane") or {}).get("pane") or {}
        pane_id = pane.get("pane_id") or ""
        if pane.get("tab_id"):
            herdr("tab", "rename", pane["tab_id"], TAB_NAME)
    if pane_id:
        herdr("pane", "zoom", pane_id, "--on")


def main(argv: list[str]) -> int:
    entry = argv[1] if len(argv) > 1 else "chat"
    mode = argv[2] if len(argv) > 2 else "tab"
    try:
        if mode == "tab":
            open_tab(entry)
        elif mode == "popup":
            herdr("plugin", "pane", "open", "--plugin", "argos", "--entrypoint", entry)
        else:
            herdr("plugin", "pane", "open", "--plugin", "argos", "--entrypoint", entry,
                  "--placement", "split", "--direction", "right", "--focus")
    except RuntimeError as exc:
        print(f"argos-open: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
