secrets/*
!secrets/*.sops.yaml
!secrets/README.md
!secrets/*.example.yaml
# Inventario de infraestructura (IPs, claves, usuarios, notas): NUNCA se versiona
secrets/inventory.yaml
*.agekey
# Rutas/IDs locales para compose (generado por scripts/setup-env.sh)
.env
.env.hooks
.env.matrix
